# =============================================================================
# .env.example — Template for environment variables
#
# PURPOSE: This file is COMMITTED to Git so other developers know what
#          variables are needed. However it contains NO REAL VALUES.
#
# USAGE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env — it is in .gitignore
#
# WHY THIS MATTERS:
#   If .env leaks to GitHub, anyone can use your API keys.
#   OpenAI API bills can reach thousands of dollars in hours.
#   Database passwords can expose all user data.
#   JWT secrets allow attackers to forge auth tokens (login as anyone).
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/rag_assistant
DATABASE_URL=

# =============================================================================
# AI / LLM CONFIGURATION
# =============================================================================

# LLM Provider API Key
# For Groq (free): https://console.groq.com/
# For OpenAI: https://platform.openai.com/api-keys
LLM_API_KEY=

# Which LLM provider to use: "openai" | "groq" | "google"
LLM_PROVIDER=groq

# LLM model name
# Groq examples: llama-3.3-70b-versatile, mixtral-8x7b-32768
# OpenAI examples: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Base URL for OpenAI-compatible APIs (leave blank for official OpenAI)
# For Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================

# Embedding provider: "local" (sentence-transformers) | "openai"
EMBEDDING_PROVIDER=local

# Local sentence-transformers model name (used when EMBEDDING_PROVIDER=local)
# Recommended: all-MiniLM-L6-v2 (fast, good quality, free, 384 dimensions)
# Alternative: all-mpnet-base-v2 (higher quality, 768 dimensions, slower)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# OpenAI embedding model (used when EMBEDDING_PROVIDER=openai)
# text-embedding-3-small: lower cost, good quality, 1536 dimensions
# text-embedding-3-large: higher quality, higher cost
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# SECURITY
# =============================================================================

# JWT Secret Key — used to sign authentication tokens
# MUST be long, random, and secret
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT algorithm (do not change unless you know what you're doing)
JWT_ALGORITHM=HS256

# JWT token expiry in minutes (60 = 1 hour)
JWT_EXPIRE_MINUTES=60

# =============================================================================
# BACKEND SERVER
# =============================================================================

# FastAPI server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Environment: "development" | "production"
ENVIRONMENT=development

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file size in megabytes
MAX_FILE_SIZE_MB=50

# Directory to store uploaded files (relative to backend/)
UPLOAD_DIR=uploads

# =============================================================================
# RAG CONFIGURATION
# =============================================================================

# Number of chunks to retrieve per query (top-K)
RETRIEVAL_TOP_K=5

# Chunk size in characters (approximate)
CHUNK_SIZE=1000

# Chunk overlap in characters
CHUNK_OVERLAP=200

# =============================================================================
# FRONTEND
# =============================================================================

# Frontend development server port
VITE_PORT=5173

# Backend API base URL (used by React frontend)
VITE_API_BASE_URL=http://localhost:8000
