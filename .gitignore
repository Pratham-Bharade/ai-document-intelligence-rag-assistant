# =============================================================================
# AI Document Intelligence & RAG Assistant
# .gitignore — Files that should NEVER be committed to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS — THE MOST IMPORTANT SECTION
# These files contain API keys, passwords, and tokens.
# If these are committed, attackers can steal your API keys (expensive!)
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.staging
*.key
*.pem   
secrets/

# -----------------------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------------------

# Virtual environments — each developer creates their own
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode — compiled versions of .py files (auto-generated)
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Testing and coverage reports
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checking
.mypy_cache/
.dmypy.json

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# NODE / FRONTEND
# -----------------------------------------------------------------------------

# Node modules — installed via npm, never committed (use package.json instead)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Frontend build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# Local SQLite databases (if used for testing)
*.db
*.sqlite
*.sqlite3

# Database dumps
*.sql.gz
*.dump

# -----------------------------------------------------------------------------
# AI / ML — Large model files, never commit these
# -----------------------------------------------------------------------------
*.bin
*.safetensors
*.ckpt
*.pt
*.onnx
/models/
!backend/app/models/
model_cache/

# FAISS index files (can be large)
*.faiss
*.index

# Uploaded documents (user data, not code)
backend/uploads/
uploads/

# -----------------------------------------------------------------------------
# IDE AND EDITOR
# -----------------------------------------------------------------------------

# VS Code (team settings in .vscode/extensions.json are ok to commit)
.vscode/settings.json
.vscode/launch.json

# JetBrains IDEs
.idea/

# Vim
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# DOCKER
# -----------------------------------------------------------------------------

# Docker override files with local secrets
docker-compose.override.yml

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
*.log
logs/
log/

# -----------------------------------------------------------------------------
# TEMPORARY FILES
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
